# Copy to .env and fill in. .env is git-ignored.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Generation provider
# ---------------------------------------------------------------------------
# Which provider backs answer generation and visual reasoning.
# One of: openai | local | echo
#   openai -> OpenAI API (default; gpt-4o-mini for both text and vision)
#   local  -> any OpenAI-compatible local server (Ollama, llama.cpp, vLLM)
#   echo   -> no-op stub that returns the prompt; used in tests and dry runs
MMRAG_GENERATION_PROVIDER=openai

OPENAI_API_KEY=sk-replace-me
# Optional: point at a proxy or compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# For MMRAG_GENERATION_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama

# ---------------------------------------------------------------------------
# Postgres (element + document metadata)
# ---------------------------------------------------------------------------
POSTGRES_USER=mmrag
POSTGRES_PASSWORD=mmrag
POSTGRES_DB=mmrag
POSTGRES_HOST=localhost
# 5433 by default to avoid colliding with a system Postgres on 5432.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Qdrant (dense + multi-vector indexes)
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Where HuggingFace caches sentence-transformers / ColQwen weights.
# HF_HOME=./.cache/huggingface
MMRAG_LOG_LEVEL=INFO
