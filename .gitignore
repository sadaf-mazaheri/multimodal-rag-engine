# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
.coverage.*

# --- Secrets ---
.env
.env.*
!.env.example

# --- Data ---
# Source PDFs are fetched via the committed manifest, never committed themselves.
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/indexes/**
!data/indexes/.gitkeep

# Evaluation gold sets and run outputs ARE committed (they are the research record),
# except for bulky per-run artifacts.
data/eval/runs/**
!data/eval/runs/.gitkeep
# Generation-evaluation artefacts and the LLM response cache: both derived, both
# potentially large, and the cache is reproducible from its requests.
data/eval/generation/**
data/eval/cache/**
# Production-evaluation reports: derived from the runs above and reproducible.
data/eval/production/**
!data/eval/production/.gitkeep

# --- Model caches ---
.cache/
models/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
